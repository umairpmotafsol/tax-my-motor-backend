# --- server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated origins allowed to call the API. "*" in development only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- database -------------------------------------------------------------
DATABASE=mongodb+srv://user:pass@cluster.mongodb.net/chwezidb?retryWrites=true&w=majority

# --- auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- encryption at rest ---------------------------------------------------
# 32-byte key, hex encoded, for Direct Debit account numbers.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- business rules -------------------------------------------------------
# How long a supplier has to upload the invoice, in milliseconds.
RESPONSE_TIMEOUT_MS=420000
SERVICE_FEE=40
V62_FEE=40

# --- uploads --------------------------------------------------------------
# Where invoice photos go.
#
# With CLOUDINARY_URL set they are stored on Cloudinary, and that hosted
# copy is what an admin sends to a customer over WhatsApp — WhatsApp
# fetches a link with no bearer token, so an authenticated API route
# cannot be the customer's copy.
#
# Leave it blank and photos are written to UPLOAD_DIR instead. That works
# for one developer on one machine and nothing else: the disk is empty
# after a redeploy, is not shared between instances, and an admin cannot
# send what is on it.
#
# Copy the whole line from https://console.cloudinary.com — Dashboard,
# "API environment variable".
CLOUDINARY_URL=
CLOUDINARY_FOLDER=taxmymotor/invoices

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# --- seeding --------------------------------------------------------------
# Set true to seed suppliers, admin and demo accounts on boot (dev only).
SEED_ON_BOOT=false
SEED_DEMO_ORDERS=false

# --- payments (Stripe) ------------------------------------------------------
# https://dashboard.stripe.com/apikeys — until these are set, /payments/*
# answers 503 rather than pretending to take a card.
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — the signing secret for the
# endpoint you point at POST /api/payments/webhook.
STRIPE_WEBHOOK_SECRET=
# Safe to expose to the apps — it only authorises reading a client secret,
# never a charge. Served back from GET /pricing/options.
STRIPE_PUBLISHABLE_KEY=

# --- vehicle tax lookup (Vehicle Data Global) --------------------------------
# https://portal.vehicledataglobal.com/ — sign in for the API key.
# The client calls:
#   GET {VEHICLE_DATA_BASE_URL}/r2/lookup
#     ?ApiKey=<key>&PackageName=<package>&Vrm=<reg>
# and reads Results.VehicleTaxDetails (see
# vehicledataglobal.com/DataSources/VehicleTaxDetails).
VEHICLE_DATA_API_KEY=
VEHICLE_DATA_BASE_URL=https://uk.api.vehicledataglobal.com
# The package configured on the account. "Tax" returns VehicleTaxDetails.
VEHICLE_DATA_PACKAGE=Tax

# Optional second package for the identity fields the Tax package does
# not carry - model, colour, VIN, fuel type. Empty means a lookup shows
# only make and year rather than guessing the rest. Each package is
# billed separately, so this doubles the cost of a plate. "DVLA" is the
# one that carries all four; it has to be enabled on the account first.
VEHICLE_DATA_DETAILS_PACKAGE=

# THIS IS PAY-AS-YOU-GO. Every successful lookup is billed, so nothing
# is sent upstream until this is explicitly true. Left false, the API
# serves whatever is already cached, and in development falls back to
# the provider's own documented sample — so the tax screens can be
# built and demoed without spending anything. In production, false
# means the route answers 503 rather than inventing a tax record.
VEHICLE_DATA_LIVE=false

# How long one paid answer is reused before another call is worth
# making. 86400000 = 24h. A tax due date does not move, so this can go
# higher; raise it to spend less.
VEHICLE_DATA_CACHE_TTL_MS=86400000

# Hard ceiling on billed calls per UTC day, counted in the database so
# a restart or a second instance cannot reset it. Past this the route
# answers from the cache — stale if need be — or 503.
VEHICLE_DATA_DAILY_LIMIT=200

# The provider limits tax lookups to 1 per second; calls are spaced by
# at least this many milliseconds.
VEHICLE_DATA_MIN_INTERVAL_MS=1100
VEHICLE_DATA_TIMEOUT_MS=10000
